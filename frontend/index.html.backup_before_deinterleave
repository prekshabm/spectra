<script>

/* ============================================================
   BASIC HELPERS
============================================================ */

const $ = x => document.getElementById(x);

const set = (id,v) => {
  const el = $(id);
  if(el) el.textContent = v;
};

function num(v,d=2){

  return Number.isFinite(Number(v))
    ? Number(v).toFixed(d)
    : '—';

}

function hz(v){

  return Number.isFinite(Number(v))
    ? Number(v).toLocaleString(
        undefined,
        {
          maximumFractionDigits:2
        }
      ) + ' Hz'
    : '—';

}

function db(v){

  return Number.isFinite(Number(v))
    ? Number(v).toFixed(2) + ' dB'
    : '—';

}

function pct(v){

  return Number.isFinite(Number(v))
    ? Number(v).toFixed(2) + '%'
    : '—';

}

function row(a,b){

  return `
    <tr>
      <td>${a}</td>
      <td>${b}</td>
    </tr>
  `;

}

function setStatus(type,text){

  const s = $('status');

  s.className = 'status ' + type;

  s.innerHTML =
    `<i></i><span>${text}</span>`;

}


/* ============================================================
   FILE UI
============================================================ */

function updateFileName(){

  const f = $('file').files[0];

  set(
    'fileName',
    f
      ? `${f.name} • ${(f.size/1024).toFixed(1)} KB`
      : 'No file selected'
  );

}

$('file').addEventListener(
  'change',
  updateFileName
);


const drop = $('drop');

[
  'dragenter',
  'dragover'
].forEach(
  e => drop.addEventListener(
    e,
    x => {
      x.preventDefault();
      drop.classList.add('drag');
    }
  )
);


[
  'dragleave',
  'drop'
].forEach(
  e => drop.addEventListener(
    e,
    x => {
      x.preventDefault();
      drop.classList.remove('drag');
    }
  )
);


drop.addEventListener(
  'drop',
  e => {

    const files =
      e.dataTransfer.files;

    if(files.length){

      $('file').files = files;

      updateFileName();

    }

  }
);


/* ============================================================
   DIGITAL RESET
============================================================ */

function resetDigital(){

  set('demodStatus','Waiting for analysis');

  set('demodMod','—');
  set('symbolRate','—');
  set('sps','—');
  set('symbolsRecovered','—');
  set('bitsRecovered','—');
  set('bitBalance','—');

  set('fecStatus','Waiting for analysis');

  set('fecEvidence','—');
  set('fecConfidence','—');
  set('parityEvidence','—');
  set('repetitionEvidence','—');
  set('copyAgreement','—');
  set('hammingEvidence','—');

  set(
    'codeRates',
    '<span class="empty">—</span>'
  );

  $('fecReasons').innerHTML =
    '<li>No FEC evidence available.</li>';

  set(
    'bitstream',
    'No recovered bitstream available.'
  );

  set(
    'bitstreamInfo',
    '0 bits'
  );

  $('copyBits').disabled = true;

  set(
    'interleavingStatus',
    'Waiting for analysis'
  );

  set('interleavingEvidence','—');
  set('interleavingConfidence','—');
  set('transitionRate','—');
  set('meanRun','—');
  set('maxRun','—');
  set('strongestLag','—');
  set('correlation','—');
  set('periodicity','—');
  set('blockVariation','—');

}


/* ============================================================
   EVIDENCE HELPERS
============================================================ */

function evidenceClass(value){

  const v =
    String(value || '').toUpperCase();

  if(v === 'LIKELY')
    return 'good';

  if(v === 'POSSIBLE')
    return 'warn';

  return 'neutral';

}


function evidencePill(value){

  const cls =
    evidenceClass(value);

  return `
    <span class="status-pill ${cls}">
      ${value || '—'}
    </span>
  `;

}


/* ============================================================
   DIGITAL RENDERING
============================================================ */

function renderDigital(d){

  resetDigital();


  /* ----------------------------------------------------------
     DEMODULATION
  ---------------------------------------------------------- */

  const demod =
    d.demodulation || {};

  if(demod.available){

    set(
      'demodStatus',
      'Demodulation complete'
    );

    set(
      'demodMod',
      demod.modulation || '—'
    );

    set(
      'symbolRate',
      Number.isFinite(
        Number(demod.symbol_rate)
      )
        ? Number(
            demod.symbol_rate
          ).toLocaleString() + ' Sym/s'
        : '—'
    );

    set(
      'sps',
      num(
        demod.samples_per_symbol,
        2
      )
    );

    set(
      'symbolsRecovered',
      Number(
        demod.symbols_recovered || 0
      ).toLocaleString()
    );

    set(
      'bitsRecovered',
      Number(
        demod.bits_recovered || 0
      ).toLocaleString()
    );

    set(
      'bitBalance',
      `${num(demod.zero_percentage,2)}% / ${num(demod.one_percentage,2)}%`
    );


    /* --------------------------------------------------------
       BITSTREAM
    -------------------------------------------------------- */

    const bits =
      String(
        demod.bitstream || ''
      );

    if(bits.length){

      set(
        'bitstream',
        bits
      );

      set(
        'bitstreamInfo',
        `${bits.length.toLocaleString()} bits`
      );

      $('copyBits').disabled = false;

    }else{

      set(
        'bitstream',
        'Demodulation completed, but no bitstream was recovered.'
      );

      set(
        'bitstreamInfo',
        '0 bits'
      );

    }

  }else{

    set(
      'demodStatus',
      demod.reason || 'Demodulation unavailable'
    );

  }


  /* ----------------------------------------------------------
     FEC
  ---------------------------------------------------------- */

  const fec =
    d.fec || {};

  if(fec.available){

    set(
      'fecStatus',
      'Analysis complete'
    );


    const fecEvidence =
      String(
        fec.fec_evidence || 'NONE'
      );

    $('fecEvidence').innerHTML =
      evidencePill(
        fecEvidence
      );


    set(
      'fecConfidence',
      pct(fec.confidence)
    );


    set(
      'parityEvidence',
      num(
        fec.parity_evidence,
        4
      )
    );


    set(
      'repetitionEvidence',
      num(
        fec.repetition_evidence,
        4
      )
    );


    set(
      'copyAgreement',
      num(
        fec.copy_agreement,
        4
      )
    );


    set(
      'hammingEvidence',
      num(
        fec.hamming_syndrome_evidence,
        4
      )
    );


    /* --------------------------------------------------------
       CODE RATES
    -------------------------------------------------------- */

    const rates =
      Array.isArray(
        fec.code_rate_candidates
      )
        ? fec.code_rate_candidates
        : [];

    if(rates.length){

      $('codeRates').innerHTML =
        rates
          .map(
            r =>
              `<span class="rate-chip">${r}</span>`
          )
          .join('');

    }else{

      $('codeRates').innerHTML =
        '<span class="empty">None identified</span>';

    }


    /* --------------------------------------------------------
       REASONS
    -------------------------------------------------------- */

    const reasons =
      Array.isArray(
        fec.evidence_reasons
      )
        ? fec.evidence_reasons
        : [];

    if(reasons.length){

      $('fecReasons').innerHTML =
        reasons
          .map(
            r => `<li>${r}</li>`
          )
          .join('');

    }else{

      $('fecReasons').innerHTML =
        '<li>No strong FEC evidence.</li>';

    }

  }else{

    set(
      'fecStatus',
      fec.reason || 'FEC unavailable'
    );

  }


  /* ----------------------------------------------------------
     INTERLEAVING
  ---------------------------------------------------------- */

  const inter =
    d.interleaving || {};

  if(inter.available){

    const evidence =
      String(
        inter.interleaving_evidence ||
        'NONE'
      );


    set(
      'interleavingStatus',
      'Analysis complete'
    );


    $('interleavingEvidence').innerHTML =
      evidencePill(
        evidence
      );


    set(
      'interleavingConfidence',
      pct(
        inter.confidence
      )
    );


    set(
      'transitionRate',
      pct(
        inter.transition_percentage
      )
    );


    set(
      'meanRun',
      num(
        inter.mean_run_length,
        3
      )
    );


    set(
      'maxRun',
      Number.isFinite(
        Number(inter.max_run_length)
      )
        ? Number(
            inter.max_run_length
          ).toLocaleString()
        : '—'
    );


    set(
      'strongestLag',
      Number.isFinite(
        Number(inter.strongest_lag)
      )
        ? Number(
            inter.strongest_lag
          ).toLocaleString()
        : '—'
    );


    set(
      'correlation',
      num(
        inter.strongest_correlation,
        4
      )
    );


    set(
      'periodicity',
      num(
        inter.periodicity_score,
        4
      )
    );


    set(
      'blockVariation',
      num(
        inter.block_balance_variation,
        4
      )
    );

  }else{

    set(
      'interleavingStatus',
      inter.reason ||
      'Interleaving unavailable'
    );

  }

}


/* ============================================================
   COPY BITSTREAM
============================================================ */

$('copyBits').addEventListener(
  'click',
  async () => {

    const text =
      $('bitstream').textContent.trim();

    if(
      !text ||
      text.startsWith(
        'No recovered'
      )
    ){
      return;
    }

    try{

      await navigator.clipboard.writeText(
        text
      );

      const btn =
        $('copyBits');

      const old =
        btn.textContent;

      btn.textContent =
        'Copied';

      setTimeout(
        () => {
          btn.textContent = old;
        },
        1200
      );

    }catch(err){

      alert(
        'Unable to copy the bitstream.'
      );

    }

  }
);


/* ============================================================
   ANALYZE
============================================================ */

$('go').onclick = async () => {

  const f =
    $('file').files[0];

  if(!f){

    return alert(
      'Choose an IQ or WAV file first.'
    );

  }


  setStatus(
    'busy',
    'ANALYZING'
  );

  $('go').disabled = true;

  $('go').innerHTML =
    '<span class="spinner"></span> Analyzing…';


  const fd =
    new FormData();

  fd.append(
    'file',
    f
  );

  fd.append(
    'sample_rate',
    $('fs').value
  );

  fd.append(
    'dtype',
    $('dtype').value
  );

  fd.append(
    'iq_format',
    $('iq').value
  );


  try{

    const r =
      await fetch(
        '/api/analyze',
        {
          method:'POST',
          body:fd
        }
      );


    const d =
      await r.json();


    if(!r.ok){

      throw Error(
        d.detail ||
        'Analysis failed'
      );

    }


    const c =
      d.classification || {};

    const p =
      d.parameters || {};


    /* --------------------------------------------------------
       OVERVIEW METRICS
    -------------------------------------------------------- */

    set(
      'mod',
      c.detected || 'Unknown'
    );


    set(
      'conf',
      Number.isFinite(
        Number(c.confidence)
      )
        ? Number(
            c.confidence
          ).toFixed(1) + '%'
        : '—'
    );


    set(
      'snr',
      db(d.snr_db)
    );


    set(
      'freq',
      hz(d.dominant_frequency)
    );


    set(
      'samples',
      Number(
        d.samples || 0
      ).toLocaleString()
    );


    set(
      'rate',
      Number(
        d.sample_rate || 0
      ).toLocaleString() +
      ' Hz'
    );


    set(
      'dur',
      num(
        d.duration,
        4
      ) + ' s'
    );


    set(
      'bw',
      hz(d.bandwidth)
    );


    /* --------------------------------------------------------
       CLASSIFICATION CANDIDATES
    -------------------------------------------------------- */

    $('cand').innerHTML =
      (c.candidates || [])
        .map(
          x => {

            const q =
              Math.min(
                100,
                Math.max(
                  0,
                  Number(
                    x.probability
                  ) || 0
                )
              );

            return `
              <div class="candidate">

                <div class="name">
                  ${x.modulation}
                </div>

                <div class="track">

                  <div
                    class="fill"
                    style="width:${q}%"
                  ></div>

                </div>

                <div class="pct">
                  ${q.toFixed(2)}%
                </div>

              </div>
            `;

          }
        )
        .join('')
      ||
      '<div class="empty">No classification available.</div>';


    /* --------------------------------------------------------
       PARAMETERS
    -------------------------------------------------------- */

    $('params').innerHTML =

      row(
        'Global spectral peak',
        hz(
          p.global_spectral_peak_hz
        )
      )

      +

      row(
        'Current-window peak',
        hz(
          p.current_window_peak_hz
        )
      )

      +

      row(
        'Occupied bandwidth (−10 dB)',
        hz(
          p.occupied_bandwidth_minus10db_hz
        )
      )

      +

      row(
        '99% validated signal-power bandwidth',
        `${hz(
          p.validated_occupied_bandwidth_99pct_hz
        )} (${hz(
          p.occupied_band_start_hz
        )} – ${hz(
          p.occupied_band_end_hz
        )})`
      )

      +

      row(
        'RMS amplitude',
        num(
          p.rms_amplitude,
          5
        )
      )

      +

      row(
        'DC offset magnitude',
        num(
          p.dc_offset_magnitude,
          6
        )
      )

      +

      row(
        'DC offset I',
        num(
          p.dc_offset_i,
          6
        )
      )

      +

      row(
        'DC offset Q',
        num(
          p.dc_offset_q,
          6
        )
      )

      +

      row(
        'Peak amplitude',
        num(
          p.peak_amplitude,
          5
        )
      )

      +

      row(
        'Signal power',
        num(
          p.signal_power,
          6
        )
      )

      +

      row(
        'Center frequency',
        hz(
          p.center_frequency_hz
        )
      )

      +

      row(
        'Frequency offset',
        hz(
          p.frequency_offset_hz
        )
      )

      +

      row(
        'Symbol-rate candidate',
        p.symbol_rate_candidate_sym_s
          ? num(
              p.symbol_rate_candidate_sym_s,
              1
            ) + ' Sym/s'
          : '—'
      )

      +

      row(
        'Analysis windows',
        Number(
          p.analysis_windows || 0
        ).toLocaleString()
      )

      +

      row(
        'Validated signal regions',
        Number(
          p.validated_signal_regions || 0
        ).toLocaleString()
      );


    /* --------------------------------------------------------
       NOISE
    -------------------------------------------------------- */

    $('noiseParams').innerHTML =

      row(
        'Spectral noise floor',
        db(
          p.noise_floor_db_per_hz
        )
      )

      +

      row(
        'Equivalent noise RMS',
        num(
          p.noise_rms_equivalent,
          6
        )
      )

      +

      row(
        'Total noise power',
        num(
          d.noise_power,
          8
        )
      )

      +

      row(
        'In-band noise power',
        num(
          p.noise_power_total,
          8
        )
      )

      +

      row(
        'Peak-to-noise-floor',
        db(
          p.peak_to_noise_floor_db
        )
      )

      +

      row(
        'Total-power SNR',
        db(
          p.spectral_snr_db
        )
      )

      +

      row(
        'In-band SNR',
        db(
          p.inband_snr_db
        )
      );


    set(
      'noiseFloorTop',
      db(
        p.noise_floor_db_per_hz
      )
    );


    set(
      'noisePowerTop',
      num(
        d.noise_power,
        6
      )
    );


    set(
      'snrTop',
      db(
        p.spectral_snr_db
      )
    );


    set(
      'inbandTop',
      db(
        p.inband_snr_db
      )
    );


    /* --------------------------------------------------------
       DIGITAL ANALYSIS
    -------------------------------------------------------- */

    renderDigital(d);


    /* --------------------------------------------------------
       PLOTS
    -------------------------------------------------------- */

    plot(d);


    setStatus(
      'ready',
      'ANALYSIS COMPLETE'
    );


    /* Automatically bring the new digital section into view
       only after successful analysis. */

    setTimeout(
      () => {

        const digital =
          $('digital');

        if(digital){

          digital.scrollIntoView({
            behavior:'smooth',
            block:'start'
          });

        }

      },
      250
    );


  }catch(e){

    setStatus(
      'error',
      'ANALYSIS ERROR'
    );

    alert(
      e.message
    );

  }finally{

    $('go').disabled = false;

    $('go').textContent =
      'Analyze Signal';

  }

};


/* ============================================================
   PLOT LAYOUT
============================================================ */

function baseLayout(){

  return {

    paper_bgcolor:'transparent',

    plot_bgcolor:'#081721',

    font:{
      color:'#cfe0e8',
      family:'Inter, Segoe UI, Arial'
    },

    margin:{
      t:10,
      l:58,
      r:18,
      b:48
    },

    hoverlabel:{
      bgcolor:'#0b1a25',
      bordercolor:'#345365',
      font:{
        color:'#fff'
      }
    },

    xaxis:{
      gridcolor:'#17313e',
      zerolinecolor:'#294755'
    },

    yaxis:{
      gridcolor:'#17313e',
      zerolinecolor:'#294755'
    }

  };

}


/* ============================================================
   PLOTS
============================================================ */

function plot(d){

  const cfg = {

    responsive:true,

    displaylogo:false,

    modeBarButtonsToRemove:[
      'lasso2d',
      'select2d',
      'autoScale2d'
    ]

  };


  if(d.spectrum){

    const layout =
      baseLayout();

    layout.xaxis = {
      ...layout.xaxis,
      title:'Frequency (Hz)'
    };

    layout.yaxis = {
      ...layout.yaxis,
      title:'PSD (dB/Hz)'
    };


    Plotly.newPlot(
      'spectrum',
      [
        {
          x:d.spectrum.frequency,
          y:d.spectrum.power_db,
          type:'scatter',
          mode:'lines',
          line:{
            width:1.5
          }
        }
      ],
      layout,
      cfg
    );

  }


  if(d.constellation){

    const layout =
      baseLayout();

    layout.xaxis = {
      ...layout.xaxis,
      title:'I',
      scaleanchor:'y'
    };

    layout.yaxis = {
      ...layout.yaxis,
      title:'Q'
    };


    Plotly.newPlot(
      'constellation',
      [
        {
          x:d.constellation.i,
          y:d.constellation.q,
          mode:'markers',
          type:'scattergl',
          marker:{
            size:3,
            opacity:.72
          }
        }
      ],
      layout,
      cfg
    );

  }


  if(d.waterfall){

    const layout =
      baseLayout();

    layout.xaxis = {
      ...layout.xaxis,
      title:'Frequency (Hz)'
    };

    layout.yaxis = {
      ...layout.yaxis,
      title:'Time (s)'
    };


    Plotly.newPlot(
      'waterfall',
      [
        {
          z:d.waterfall.power_db,
          x:d.waterfall.frequency,
          y:d.waterfall.time,
          type:'heatmap',
          colorbar:{
            title:'dB'
          }
        }
      ],
      layout,
      cfg
    );

  }

}


/* ============================================================
   SIDEBAR SCROLL TRACKING
============================================================ */

const sections =
  [
    ...document.querySelectorAll(
      'section[id]'
    )
  ];

const links =
  [
    ...document.querySelectorAll(
      '.nav a'
    )
  ];


window.addEventListener(
  'scroll',
  () => {

    let current =
      'overview';

    sections.forEach(
      s => {

        if(
          window.scrollY >=
          s.offsetTop - 130
        ){

          current =
            s.id;

        }

      }
    );


    links.forEach(
      a => {

        a.classList.toggle(
          'active',
          a.getAttribute('href') ===
          '#' + current
        );

      }
    );

  }
);


/* ============================================================
   INITIAL STATE
============================================================ */

resetDigital();

</script>

