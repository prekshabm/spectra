<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>SPECTRA v16 • Signal Analysis</title>

<script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>

<style>

:root{
  --bg:#061019;
  --panel:#0b1a25;
  --panel2:#0e202d;
  --line:#1d3949;
  --line2:#2a4b5d;
  --text:#edf6fb;
  --muted:#8ea7b6;
  --accent:#55d7ff;
  --accent2:#7ce7b1;
  --warn:#ffd166;
  --danger:#ff7d8a;
  --shadow:0 16px 45px rgba(0,0,0,.22)
}

*{
  box-sizing:border-box
}

html{
  scroll-behavior:smooth
}

body{
  margin:0;
  background:
    radial-gradient(
      circle at 75% -10%,
      #123044 0,
      #07131c 34%,
      var(--bg) 70%
    );
  color:var(--text);
  font:14px Inter,Segoe UI,Arial,sans-serif;
  min-height:100vh
}

button,input,select{
  font:inherit
}

.app{
  display:grid;
  grid-template-columns:238px 1fr;
  min-height:100vh
}

.sidebar{
  position:sticky;
  top:0;
  height:100vh;
  padding:24px 16px;
  border-right:1px solid var(--line);
  background:rgba(5,15,23,.86);
  backdrop-filter:blur(16px);
  z-index:10
}

.brand{
  display:flex;
  align-items:center;
  gap:10px;
  padding:4px 10px 28px
}

.logo{
  width:34px;
  height:34px;
  border:1px solid #3b7890;
  border-radius:10px;
  display:grid;
  place-items:center;
  color:var(--accent);
  font-weight:800;
  box-shadow:0 0 22px rgba(85,215,255,.14)
}

.brand b{
  font-size:18px;
  letter-spacing:.12em
}

.brand span{
  display:block;
  color:var(--muted);
  font-size:10px;
  margin-top:2px;
  letter-spacing:.08em
}

.nav{
  display:grid;
  gap:5px
}

.nav a{
  color:#a9bfca;
  text-decoration:none;
  padding:11px 12px;
  border-radius:9px;
  display:flex;
  gap:10px;
  align-items:center;
  border:1px solid transparent
}

.nav a:hover,
.nav a.active{
  background:#0d2330;
  border-color:#214354;
  color:#fff
}

.nav .dot{
  width:6px;
  height:6px;
  border-radius:50%;
  background:#466778
}

.sidefoot{
  position:absolute;
  bottom:20px;
  left:20px;
  right:20px;
  color:#6f8998;
  font-size:11px;
  line-height:1.5
}

.main{
  min-width:0
}

.topbar{
  height:72px;
  padding:0 30px;
  border-bottom:1px solid var(--line);
  display:flex;
  align-items:center;
  justify-content:space-between;
  background:rgba(6,16,25,.55);
  backdrop-filter:blur(12px);
  position:sticky;
  top:0;
  z-index:8
}

.eyebrow{
  color:var(--accent);
  font-size:11px;
  font-weight:700;
  letter-spacing:.14em;
  text-transform:uppercase
}

.top-title{
  font-size:16px;
  font-weight:700;
  margin-top:3px
}

.status{
  display:flex;
  align-items:center;
  gap:8px;
  border:1px solid var(--line2);
  padding:8px 11px;
  border-radius:999px;
  background:#091822;
  color:#a9c1cc;
  font-size:11px
}

.status i{
  width:7px;
  height:7px;
  border-radius:50%;
  background:#5a7380
}

.status.ready i{
  background:var(--accent2);
  box-shadow:0 0 10px rgba(124,231,177,.55)
}

.status.busy i{
  background:var(--warn);
  box-shadow:0 0 10px rgba(255,209,102,.45)
}

.status.error i{
  background:var(--danger)
}

.content{
  max-width:1500px;
  margin:auto;
  padding:28px 30px 50px
}

.hero{
  display:flex;
  justify-content:space-between;
  gap:24px;
  align-items:flex-end;
  margin-bottom:22px
}

.hero h1{
  margin:0;
  font-size:30px;
  letter-spacing:-.03em
}

.hero p{
  margin:8px 0 0;
  color:var(--muted);
  max-width:700px
}

.hero-meta{
  display:flex;
  gap:8px;
  flex-wrap:wrap
}

.chip{
  border:1px solid var(--line);
  background:#091822;
  color:#9eb4c0;
  border-radius:999px;
  padding:7px 10px;
  font-size:11px
}

.card{
  background:
    linear-gradient(
      145deg,
      rgba(13,31,43,.96),
      rgba(8,22,31,.96)
    );
  border:1px solid var(--line);
  border-radius:15px;
  box-shadow:var(--shadow)
}

.upload{
  padding:18px;
  margin-bottom:20px
}

.upload-grid{
  display:grid;
  grid-template-columns:1.5fr 1fr 150px 140px auto;
  gap:10px;
  align-items:center
}

.drop{
  border:1px dashed #315568;
  border-radius:11px;
  min-height:52px;
  padding:8px 12px;
  display:flex;
  align-items:center;
  gap:10px;
  background:#081721;
  transition:.2s
}

.drop.drag{
  border-color:var(--accent);
  background:#0a202b
}

.drop input{
  display:none
}

.choose{
  padding:9px 12px;
  border:1px solid var(--line2);
  border-radius:8px;
  background:#102c3b;
  cursor:pointer;
  white-space:nowrap
}

.file-name{
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  color:#d9e8ee
}

.field{
  display:flex;
  flex-direction:column;
  gap:5px
}

.field label{
  font-size:10px;
  text-transform:uppercase;
  letter-spacing:.1em;
  color:#708b99
}

.field input,
.field select{
  height:42px;
  width:100%;
  background:#081721;
  color:#eaf5f9;
  border:1px solid var(--line2);
  border-radius:9px;
  padding:0 11px;
  outline:none
}

.field input:focus,
.field select:focus{
  border-color:#4f94ad;
  box-shadow:0 0 0 3px rgba(85,215,255,.08)
}

.primary{
  height:42px;
  border:1px solid #3e829c;
  border-radius:9px;
  background:linear-gradient(135deg,#15506a,#12384a);
  color:#fff;
  font-weight:700;
  cursor:pointer;
  padding:0 16px;
  white-space:nowrap
}

.primary:hover{
  filter:brightness(1.12)
}

.primary:disabled{
  opacity:.55;
  cursor:not-allowed
}

.file-hint{
  grid-column:1/-1;
  color:#718b98;
  font-size:11px;
  padding-left:2px
}

.section-title{
  display:flex;
  align-items:end;
  justify-content:space-between;
  margin:26px 0 12px
}

.section-title h2{
  margin:0;
  font-size:16px
}

.section-title span{
  font-size:11px;
  color:var(--muted)
}

.metrics{
  display:grid;
  grid-template-columns:repeat(8,1fr);
  gap:10px
}

.metric{
  padding:15px 16px;
  min-height:105px
}

.metric .label{
  color:#86a1af;
  text-transform:uppercase;
  letter-spacing:.08em;
  font-size:10px;
  font-weight:700
}

.metric .value{
  font-size:21px;
  font-weight:750;
  margin-top:14px;
  letter-spacing:-.02em;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap
}

.metric.primary-metric{
  border-color:#27586b;
  background:linear-gradient(145deg,#0d2634,#0a1b26)
}

.metric.primary-metric .value{
  color:var(--accent)
}

.candidates{
  padding:18px
}

.candidate{
  display:grid;
  grid-template-columns:95px 1fr 62px;
  align-items:center;
  gap:12px;
  margin:11px 0
}

.candidate .name{
  font-weight:700
}

.candidate .pct{
  text-align:right;
  color:#b7cbd4;
  font-variant-numeric:tabular-nums
}

.track{
  height:9px;
  background:#122a37;
  border:1px solid #1b3948;
  border-radius:99px;
  overflow:hidden
}

.fill{
  height:100%;
  background:linear-gradient(90deg,#2389b0,var(--accent));
  border-radius:99px;
  transition:width .5s ease
}

.empty{
  color:var(--muted);
  padding:10px 0
}

.plots{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px
}

.plot-card{
  padding:0;
  overflow:hidden
}

.plot-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:16px 18px 4px
}

.plot-head h3{
  margin:0;
  font-size:14px
}

.plot-head span{
  font-size:10px;
  color:#708995
}

.plot{
  height:370px
}

.wide .plot{
  height:440px
}

.param-layout{
  display:grid;
  grid-template-columns:1.6fr 1fr;
  gap:14px
}

.table-card{
  padding:18px
}

.subhead{
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.12em;
  color:#6f8997;
  font-weight:700;
  margin:3px 0 12px
}

table{
  width:100%;
  border-collapse:collapse
}

td{
  padding:10px 4px;
  border-bottom:1px solid rgba(39,68,82,.62);
  vertical-align:middle
}

td:first-child{
  color:#94abb7;
  width:55%
}

td:last-child{
  text-align:right;
  color:#e7f3f7;
  font-weight:600;
  font-variant-numeric:tabular-nums
}

.noise-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
  margin-bottom:14px
}

.noise-box{
  padding:14px;
  border:1px solid var(--line);
  border-radius:11px;
  background:#091821
}

.noise-box label{
  display:block;
  color:#728c99;
  font-size:10px;
  text-transform:uppercase;
  letter-spacing:.09em
}

.noise-box b{
  display:block;
  font-size:18px;
  margin-top:8px
}

.callout{
  padding:15px;
  border-radius:11px;
  border:1px solid #284656;
  background:#0a1b25;
  color:#9eb5c0;
  line-height:1.55
}

.callout strong{
  color:#dcebf0
}

/* ============================================================
   DIGITAL ANALYSIS
   ============================================================ */

.digital-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px
}

.digital-card{
  padding:18px
}

.digital-card.full{
  grid-column:1/-1
}

.digital-title{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:16px
}

.digital-title h3{
  margin:0;
  font-size:15px
}

.digital-title span{
  color:var(--muted);
  font-size:10px
}

.status-pill{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:6px 10px;
  border-radius:999px;
  border:1px solid var(--line2);
  background:#091822;
  font-size:11px;
  font-weight:800;
  letter-spacing:.04em
}

.status-pill.good{
  color:var(--accent2);
  border-color:#2e6753;
  background:#0a211b
}

.status-pill.warn{
  color:var(--warn);
  border-color:#68582c;
  background:#211d0d
}

.status-pill.neutral{
  color:#9eb4c0
}

.digital-metrics{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px
}

.digital-metric{
  padding:13px;
  border:1px solid var(--line);
  border-radius:10px;
  background:#091821
}

.digital-metric label{
  display:block;
  color:#728c99;
  font-size:9px;
  text-transform:uppercase;
  letter-spacing:.09em
}

.digital-metric b{
  display:block;
  margin-top:7px;
  font-size:17px
}

.bitstream-wrap{
  position:relative
}

.bitstream{
  width:100%;
  min-height:180px;
  max-height:330px;
  overflow:auto;
  padding:16px;
  border:1px solid var(--line2);
  border-radius:10px;
  background:#050f16;
  color:#9fe7ff;
  font-family:
    "Cascadia Mono",
    Consolas,
    "Courier New",
    monospace;
  font-size:12px;
  line-height:1.75;
  letter-spacing:.06em;
  word-break:break-all;
  white-space:pre-wrap
}

.bitstream-meta{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-top:10px;
  color:var(--muted);
  font-size:10px
}

.copy-btn{
  border:1px solid var(--line2);
  background:#102c3b;
  color:#dcebf0;
  border-radius:8px;
  padding:8px 12px;
  cursor:pointer;
  font-size:11px
}

.copy-btn:hover{
  border-color:#4f94ad;
  background:#14394a
}

.evidence{
  padding:13px;
  border-radius:10px;
  border:1px solid var(--line);
  background:#091821;
  margin-top:12px
}

.evidence label{
  display:block;
  color:#728c99;
  font-size:9px;
  text-transform:uppercase;
  letter-spacing:.09em;
  margin-bottom:8px
}

.reason-list{
  margin:0;
  padding-left:18px;
  color:#b9cbd3;
  line-height:1.7;
  font-size:12px
}

.reason-list li{
  margin:2px 0
}

.code-rates{
  display:flex;
  flex-wrap:wrap;
  gap:6px
}

.rate-chip{
  border:1px solid var(--line2);
  border-radius:999px;
  padding:5px 8px;
  color:#b9d0da;
  background:#0a1a24;
  font-size:10px
}

.disclaimer{
  margin-top:14px;
  padding:12px 14px;
  border-left:3px solid #416779;
  background:#091821;
  color:#819aa7;
  font-size:11px;
  line-height:1.55
}

.confidence-bar{
  height:8px;
  background:#122a37;
  border:1px solid #1b3948;
  border-radius:99px;
  overflow:hidden;
  margin-top:8px
}

.confidence-fill{
  height:100%;
  background:linear-gradient(90deg,#2389b0,var(--accent));
  border-radius:99px
}

.footer-note{
  margin-top:18px;
  color:#617b89;
  font-size:11px
}

.spinner{
  display:inline-block;
  width:12px;
  height:12px;
  border:2px solid #54717f;
  border-top-color:var(--accent);
  border-radius:50%;
  animation:spin .8s linear infinite;
  vertical-align:-2px
}

@keyframes spin{
  to{
    transform:rotate(360deg)
  }
}

@media(max-width:1250px){

  .metrics{
    grid-template-columns:repeat(4,1fr)
  }

  .upload-grid{
    grid-template-columns:1.5fr 1fr 130px 120px auto
  }

  .param-layout{
    grid-template-columns:1fr
  }

  .sidebar{
    width:210px
  }

  .app{
    grid-template-columns:210px 1fr
  }

}

@media(max-width:1000px){

  .digital-grid{
    grid-template-columns:1fr
  }

  .digital-card.full{
    grid-column:auto
  }

}

@media(max-width:900px){

  .app{
    display:block
  }

  .sidebar{
    position:relative;
    height:auto;
    width:auto;
    border-right:0;
    border-bottom:1px solid var(--line);
    padding:12px 16px
  }

  .brand{
    padding:4px 4px 12px
  }

  .nav{
    display:flex;
    overflow:auto
  }

  .nav a{
    white-space:nowrap
  }

  .sidefoot{
    display:none
  }

  .topbar{
    position:relative;
    padding:0 18px
  }

  .content{
    padding:20px 16px
  }

  .upload-grid{
    grid-template-columns:1fr 1fr
  }

  .drop{
    grid-column:1/-1
  }

  .primary{
    width:100%
  }

  .plots{
    grid-template-columns:1fr
  }

  .hero{
    display:block
  }

  .hero-meta{
    margin-top:14px
  }

}

@media(max-width:600px){

  .metrics{
    grid-template-columns:1fr 1fr
  }

  .upload-grid{
    grid-template-columns:1fr
  }

  .noise-grid{
    grid-template-columns:1fr 1fr
  }

  .digital-metrics{
    grid-template-columns:1fr 1fr
  }

  .metric .value{
    font-size:18px
  }

  .hero h1{
    font-size:25px
  }

  .plot{
    height:320px
  }

  .wide .plot{
    height:360px
  }

  .candidate{
    grid-template-columns:75px 1fr 54px
  }

}

</style>
</head>

<body>

<div class="app">

<aside class="sidebar">

  <div class="brand">
    <div class="logo">S</div>
    <div>
      <b>SPECTRA</b>
      <span>RF ANALYSIS PLATFORM</span>
    </div>
  </div>

  <nav class="nav">

    <a href="#overview" class="active">
      <span class="dot"></span>
      Overview
    </a>

    <a href="#modulation">
      <span class="dot"></span>
      Modulation
    </a>

    <a href="#visuals">
      <span class="dot"></span>
      Visual Analysis
    </a>

    <a href="#parameters">
      <span class="dot"></span>
      Parameters
    </a>

    <a href="#noise">
      <span class="dot"></span>
      Noise & SNR
    </a>

    <a href="#digital">
      <span class="dot"></span>
      Digital Analysis
    </a>

  </nav>

  <div class="sidefoot">
    v16 • DSP + ML<br>
    Local analysis • No signal data leaves your machine
  </div>

</aside>


<main class="main">

<header class="topbar">

  <div>
    <div class="eyebrow">
      SPECTRA / SIGNAL ANALYSIS
    </div>

    <div class="top-title">
      AI-Assisted Automated Signal Analysis Platform
    </div>
  </div>

  <div id="status" class="status ready">
    <i></i>
    <span>READY</span>
  </div>

</header>


<div class="content">


<!-- =========================================================
     OVERVIEW
========================================================= -->

<section id="overview">

  <div class="hero">

    <div>

      <h1>
        Signal Overview
      </h1>

      <p>
        Upload an IQ or WAV capture to estimate signal
        parameters, noise/SNR, modulation candidates and
        recovered digital information.
      </p>

    </div>

    <div class="hero-meta">
      <span class="chip">DSP validated</span>
      <span class="chip">ML classifier</span>
      <span class="chip">Demodulation</span>
      <span class="chip">v16.0</span>
    </div>

  </div>


  <div class="card upload">

    <div class="upload-grid">

      <div id="drop" class="drop">

        <label class="choose" for="file">
          Choose signal
        </label>

        <input
          id="file"
          type="file"
          accept=".iq,.wav,.bin"
        >

        <span id="fileName" class="file-name">
          No file selected
        </span>

      </div>


      <div class="field">

        <label>
          Sample rate (Hz)
        </label>

        <input
          id="fs"
          type="number"
          value="1000000"
          step="1"
        >

      </div>


      <div class="field">

        <label>
          Data type
        </label>

        <select id="dtype">

          <option>float32</option>
          <option>float64</option>
          <option>int16</option>
          <option>int8</option>

        </select>

      </div>


      <div class="field">

        <label>
          IQ format
        </label>

        <select id="iq">

          <option>IQ</option>
          <option>QI</option>
          <option>REAL</option>

        </select>

      </div>


      <button id="go" class="primary">
        Analyze Signal
      </button>


      <div class="file-hint">

        Supported: raw IQ (float32 / float64 / int16 / int8)
        and WAV. Set the correct sample rate and IQ layout
        before analysis.

      </div>

    </div>

  </div>


  <div class="metrics">

    <div class="card metric primary-metric">
      <div class="label">Detected modulation</div>
      <div id="mod" class="value">—</div>
    </div>

    <div class="card metric">
      <div class="label">Confidence</div>
      <div id="conf" class="value">—</div>
    </div>

    <div class="card metric">
      <div class="label">SNR</div>
      <div id="snr" class="value">—</div>
    </div>

    <div class="card metric">
      <div class="label">Dominant frequency</div>
      <div id="freq" class="value">—</div>
    </div>

    <div class="card metric">
      <div class="label">Samples</div>
      <div id="samples" class="value">—</div>
    </div>

    <div class="card metric">
      <div class="label">Sample rate</div>
      <div id="rate" class="value">—</div>
    </div>

    <div class="card metric">
      <div class="label">Duration</div>
      <div id="dur" class="value">—</div>
    </div>

    <div class="card metric">
      <div class="label">Bandwidth</div>
      <div id="bw" class="value">—</div>
    </div>

  </div>

</section>


<!-- =========================================================
     MODULATION
========================================================= -->

<section id="modulation">

  <div class="section-title">

    <h2>
      Modulation Assessment
    </h2>

    <span>
      Ranked probabilities from the trained classifier
    </span>

  </div>


  <div class="card candidates">

    <div id="cand" class="cand">

      <div class="empty">
        Analyze a signal to classify it.
      </div>

    </div>

  </div>

</section>


<!-- =========================================================
     VISUALS
========================================================= -->

<section id="visuals">

